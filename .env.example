ANTHROPIC_API_KEY=sk-ant-...        # create a dedicated key for this service; set a spend limit in the Console
TAX_MODEL=claude-opus-5-5
TAX_EFFORT=high                     # low|medium|high|xhigh|max
TAX_MAX_TURNS=14
TAX_FALLBACKS=1                     # server-side refusal fallback (beta header); set 0 if your account/platform rejects it
